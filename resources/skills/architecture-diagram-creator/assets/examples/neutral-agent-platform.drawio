        <mxCell id="legend" parent="1" vertex="1" value="Flow" style="archRole=legend;fontFamily=Helvetica;fontSize=14;html=1;whiteSpace=wrap;rounded=0;fillColor=#EDF3FF;strokeColor=#6C8EBF;strokeWidth=1;verticalAlign=top;align=left;spacing=18;fontStyle=1;fontSize=18;">
          <mxGeometry as="geometry" x="1940.0" y="25" width="570" height="1440" />
        </mxCell>
        <mxCell id="legend-badge-1" parent="1" vertex="1" value="1" style="archRole=legend-badge;fontFamily=Helvetica;fontSize=14;html=1;whiteSpace=wrap;fontSize=22;rounded=1;fillColor=#007CBD;strokeColor=#000000;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;shadow=1;glass=0;align=center;verticalAlign=middle;archStep=1;" connectable="0">
          <mxGeometry as="geometry" x="1960.0" y="97" width="40" height="38" />
        </mxCell>
        <mxCell id="legend-1" parent="1" vertex="1" value="&lt;b&gt;Accept requests&lt;/b&gt;&lt;br&gt;The requester calls the API service and receives its response." style="archRole=legend-step;fontFamily=Helvetica;fontSize=14;html=1;whiteSpace=wrap;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=16;archStep=1;">
          <mxGeometry as="geometry" x="2012.0" y="95" width="474" height="95" />
        </mxCell>
        <mxCell id="legend-badge-2" parent="1" vertex="1" value="2" style="archRole=legend-badge;fontFamily=Helvetica;fontSize=14;html=1;whiteSpace=wrap;fontSize=22;rounded=1;fillColor=#007CBD;strokeColor=#000000;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;shadow=1;glass=0;align=center;verticalAlign=middle;archStep=2;" connectable="0">
          <mxGeometry as="geometry" x="1960.0" y="237" width="40" height="38" />
        </mxCell>
        <mxCell id="legend-2" parent="1" vertex="1" value="&lt;b&gt;Publish durable work&lt;/b&gt;&lt;br&gt;The API publishes jobs to a NATS JetStream stream." style="archRole=legend-step;fontFamily=Helvetica;fontSize=14;html=1;whiteSpace=wrap;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=16;archStep=2;">
          <mxGeometry as="geometry" x="2012.0" y="235" width="474" height="95" />
        </mxCell>
        <mxCell id="legend-badge-3" parent="1" vertex="1" value="3" style="archRole=legend-badge;fontFamily=Helvetica;fontSize=14;html=1;whiteSpace=wrap;fontSize=22;rounded=1;fillColor=#007CBD;strokeColor=#000000;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;shadow=1;glass=0;align=center;verticalAlign=middle;archStep=3;" connectable="0">
          <mxGeometry as="geometry" x="1960.0" y="377" width="40" height="38" />
        </mxCell>
        <mxCell id="legend-3" parent="1" vertex="1" value="&lt;b&gt;Receive queued work&lt;/b&gt;&lt;br&gt;A durable pull consumer supplies jobs to the orchestrator; successful handling is acknowledged." style="archRole=legend-step;fontFamily=Helvetica;fontSize=14;html=1;whiteSpace=wrap;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=16;archStep=3;">
          <mxGeometry as="geometry" x="2012.0" y="375" width="474" height="95" />
        </mxCell>
        <mxCell id="legend-badge-4" parent="1" vertex="1" value="4" style="archRole=legend-badge;fontFamily=Helvetica;fontSize=14;html=1;whiteSpace=wrap;fontSize=22;rounded=1;fillColor=#007CBD;strokeColor=#000000;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;shadow=1;glass=0;align=center;verticalAlign=middle;archStep=4;" connectable="0">
          <mxGeometry as="geometry" x="1960.0" y="517" width="40" height="38" />
        </mxCell>
        <mxCell id="legend-4" parent="1" vertex="1" value="&lt;b&gt;Request model guidance&lt;/b&gt;&lt;br&gt;The orchestrator calls the external model API directly and receives its response." style="archRole=legend-step;fontFamily=Helvetica;fontSize=14;html=1;whiteSpace=wrap;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=16;archStep=4;">
          <mxGeometry as="geometry" x="2012.0" y="515" width="474" height="95" />
        </mxCell>
        <mxCell id="legend-badge-5" parent="1" vertex="1" value="5" style="archRole=legend-badge;fontFamily=Helvetica;fontSize=14;html=1;whiteSpace=wrap;fontSize=22;rounded=1;fillColor=#007CBD;strokeColor=#000000;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;shadow=1;glass=0;align=center;verticalAlign=middle;archStep=5;" connectable="0">
          <mxGeometry as="geometry" x="1960.0" y="657" width="40" height="38" />
        </mxCell>
        <mxCell id="legend-5" parent="1" vertex="1" value="&lt;b&gt;Dispatch execution&lt;/b&gt;&lt;br&gt;The orchestrator delegates bounded work to the worker service." style="archRole=legend-step;fontFamily=Helvetica;fontSize=14;html=1;whiteSpace=wrap;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=16;archStep=5;">
          <mxGeometry as="geometry" x="2012.0" y="655" width="474" height="95" />
        </mxCell>
        <mxCell id="legend-badge-6" parent="1" vertex="1" value="6" style="archRole=legend-badge;fontFamily=Helvetica;fontSize=14;html=1;whiteSpace=wrap;fontSize=22;rounded=1;fillColor=#007CBD;strokeColor=#000000;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;shadow=1;glass=0;align=center;verticalAlign=middle;archStep=6;" connectable="0">
          <mxGeometry as="geometry" x="1960.0" y="797" width="40" height="38" />
        </mxCell>
        <mxCell id="legend-6" parent="1" vertex="1" value="&lt;b&gt;Persist the outcome&lt;/b&gt;&lt;br&gt;The worker stores execution state and results in PostgreSQL." style="archRole=legend-step;fontFamily=Helvetica;fontSize=14;html=1;whiteSpace=wrap;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=16;archStep=6;">
          <mxGeometry as="geometry" x="2012.0" y="795" width="474" height="95" />
        </mxCell>
        <mxCell id="legend-badge-7" parent="1" vertex="1" value="7" style="archRole=legend-badge;fontFamily=Helvetica;fontSize=14;html=1;whiteSpace=wrap;fontSize=22;rounded=1;fillColor=#007CBD;strokeColor=#000000;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;shadow=1;glass=0;align=center;verticalAlign=middle;archStep=7;" connectable="0">
          <mxGeometry as="geometry" x="1960.0" y="937" width="40" height="38" />
        </mxCell>
        <mxCell id="legend-7" parent="1" vertex="1" value="&lt;b&gt;Store artifacts&lt;/b&gt;&lt;br&gt;The worker writes generated artifacts to shared object storage." style="archRole=legend-step;fontFamily=Helvetica;fontSize=14;html=1;whiteSpace=wrap;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=16;archStep=7;">
          <mxGeometry as="geometry" x="2012.0" y="935" width="474" height="95" />
        </mxCell>
        <mxCell id="legend-badge-8" parent="1" vertex="1" value="8" style="archRole=legend-badge;fontFamily=Helvetica;fontSize=14;html=1;whiteSpace=wrap;fontSize=22;rounded=1;fillColor=#007CBD;strokeColor=#000000;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;shadow=1;glass=0;align=center;verticalAlign=middle;archStep=8;" connectable="0">
          <mxGeometry as="geometry" x="1960.0" y="1077" width="40" height="38" />
        </mxCell>
        <mxCell id="legend-8" parent="1" vertex="1" value="&lt;b&gt;Export execution traces&lt;/b&gt;&lt;br&gt;The orchestrator sends execution telemetry directly to hosted Langfuse." style="archRole=legend-step;fontFamily=Helvetica;fontSize=14;html=1;whiteSpace=wrap;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=16;archStep=8;">
          <mxGeometry as="geometry" x="2012.0" y="1075" width="474" height="95" />
        </mxCell>
        <mxCell id="legend-key" parent="1" vertex="1" value="&lt;b&gt;Reading the connections&lt;/b&gt;&lt;br&gt;Solid gray: request or data flow.&lt;br&gt;Two arrowheads: request / response.&lt;br&gt;Dashed gray: queued work delivery.&lt;br&gt;Dashed rose: telemetry export.&lt;br&gt;Steps 6–8 are related effects, not a strict sequence." style="archRole=label;fontFamily=Helvetica;fontSize=14;html=1;whiteSpace=wrap;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=15;" connectable="0">
          <mxGeometry as="geometry" x="1960.0" y="1240" width="530" height="180" />
        </mxCell>
        <mxCell id="scope-note" parent="1" vertex="1" value="Illustrative logical architecture. Named technologies are cloud-neutral. Infrastructure-only routing is abstracted away; replicas and failure handling are omitted." style="archRole=label;fontFamily=Helvetica;fontSize=14;html=1;whiteSpace=wrap;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#545B64;" connectable="0">
          <mxGeometry as="geometry" x="240" y="1395" width="1280.0" height="60" />
        </mxCell>
