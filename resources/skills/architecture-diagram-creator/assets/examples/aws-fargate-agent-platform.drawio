        <mxCell id="legend-5" parent="1" vertex="1" value="&lt;b&gt;Request model guidance&lt;/b&gt;&lt;br&gt;The orchestrator calls the external model through NAT egress and receives its response." style="archRole=legend-step;fontFamily=Helvetica;fontSize=14;html=1;whiteSpace=wrap;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=16;archStep=5;">
