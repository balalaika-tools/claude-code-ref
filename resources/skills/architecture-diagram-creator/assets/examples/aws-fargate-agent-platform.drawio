        <mxCell id="legend-key" parent="1" vertex="1" value="&lt;b&gt;Reading the connections&lt;/b&gt;&lt;br&gt;Solid gray: request or data flow.&lt;br&gt;Two arrowheads: request / response.&lt;br&gt;Dashed gray: queued work delivery.&lt;br&gt;Dashed rose: telemetry export.&lt;br&gt;Steps 7–9 are related effects, not a strict sequence." style="archRole=label;fontFamily=Helvetica;fontSize=14;html=1;whiteSpace=wrap;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=15;" connectable="0">
