        <mxCell id="legend-4" parent="1" vertex="1" value="&lt;b&gt;Receive queued work&lt;/b&gt;&lt;br&gt;The orchestrator polls SQS and receives jobs; the arrow follows message delivery." style="archRole=legend-step;fontFamily=Helvetica;fontSize=14;html=1;whiteSpace=wrap;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=16;archStep=4;">
